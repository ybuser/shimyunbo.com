    <g class="ink climber">
      <circle class="paper-fill" cx="258" cy="117" r="14"/>
      <path class="sail-fill" d="m242 134 27-1 9 47-37 2 1-48Z"/>
      <path d="m247 139-29-28 12-37m33 66 26-19 24-24m-66 83-25 23 4 28m45-49 20 5-11 14" stroke-width="5"/>
      <path d="m218 233 13 2m41-31 14-1" stroke-width="6"/>
      <path d="m242 172 33-2"/>
    </g>
    <path class="ink route" d="m145 226-16-41 13-48-1-39 22-38" stroke-dasharray="3 8" opacity=".5"/>
  </>}
</svg>
