---
import '../styles/global.css';
import Arrow from '../components/Arrow.astro';
import {language,translate,localizedPath} from '../i18n/ui';
interface Props { title?: string; description?: string; dark?: boolean; noindex?: boolean; }
const path=Astro.url.pathname,lang=language(path),t=(s:string)=>translate(s,lang),url=(s:string)=>localizedPath(s,lang);
const {title=t('Yunbo Shim'),description=t('Research, software, and a continuing record of work by Yunbo Shim.'),dark=false,noindex=false}=Astro.props;
const en=localizedPath(path,'en'),ko=localizedPath(path,'ko');
---
<!doctype html><html lang={lang} class:list={{dark}}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/>{noindex&&<meta name="robots" content="noindex, follow"/>}<meta name="theme-color" content={dark?'#191a1b':'#fafaf7'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content={lang==='ko'?'ko_KR':'en_US'}/><meta property="og:url" content={new URL(path,'https://shimyunbo.com')}/><link rel="canonical" href={new URL(path,'https://shimyunbo.com')}/><link rel="alternate" hreflang="en" href={new URL(en,'https://shimyunbo.com')}/><link rel="alternate" hreflang="ko" href={new URL(ko,'https://shimyunbo.com')}/><link rel="alternate" hreflang="x-default" href={new URL(en,'https://shimyunbo.com')}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{title}</title></head><body><a class="skip" href="#main">{t('Skip to content')}</a><header class="site-header"><a href={url('/')} class="wordmark" aria-label={t('Yunbo Shim home')}>YS<span>.</span></a><nav class="language-toggle" aria-label={t('Language')}><a href={ko} lang="ko" hreflang="ko" data-language="ko" aria-current={lang==='ko'?'page':undefined}>한국어</a><a href={en} lang="en" hreflang="en" data-language="en" aria-current={lang==='en'?'page':undefined}>English</a></nav><nav class="main-navigation" aria-label={t('Main navigation')}>{[['/','About'],['/research/','Research'],['/cv/','CV'],['/timeline/','Timeline']].map(([href,label])=><a href={url(href)} aria-current={path===url(href)?'page':undefined} class:list={{'timeline-link':label==='Timeline'}}>{t(label)}{label==='Timeline'&&<span aria-hidden="true"><Arrow/></span>}</a>)}</nav></header><main id="main" tabindex="-1"><slot/></main><footer class="site-footer"><a href={url('/')}>{t('Yunbo Shim')}</a><span>{t('Research. Build. Keep learning.')}</span><a href="https://github.com/ybuser">GitHub <Arrow/></a><a href="https://www.linkedin.com/in/yunbo-shim">LinkedIn <Arrow/></a></footer><script>
// Keep the current page's filter query and anchor when changing languages.
const languageLinks=document.querySelectorAll<HTMLAnchorElement>('[data-language]');
function syncLanguages(){languageLinks.forEach(a=>{const target=new URL(a.href);target.search=location.search;target.hash=location.hash;a.href=target.href;});}
syncLanguages();window.addEventListener('popstate',syncLanguages);window.addEventListener('hashchange',syncLanguages);
languageLinks.forEach(a=>a.addEventListener('click',()=>syncLanguages()));
</script></body></html>
