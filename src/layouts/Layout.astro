---
import '../styles/global.css';
interface Props { title?: string; description?: string; dark?: boolean; }
const {title='Yunbo Shim',description='Research, software, and a continuing record of work by Yunbo Shim.',dark=false}=Astro.props;
const path=Astro.url.pathname;
---
<!doctype html><html lang="en" class:list={{dark}}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content={dark?'#101923':'#fafaf7'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={new URL(path,'https://shimyunbo.com')}/><link rel="canonical" href={new URL(path,'https://shimyunbo.com')}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{title}</title></head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><a href="/" class="wordmark" aria-label="Yunbo Shim home">YS<span>.</span></a><nav aria-label="Main navigation">{[['/','About'],['/research/','Research'],['/cv/','CV'],['/timeline/','Timeline']].map(([href,label])=><a href={href} aria-current={path===href?'page':undefined} class:list={{'timeline-link':label==='Timeline'}}>{label}{label==='Timeline'&&<span aria-hidden="true"><svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></span>}</a>)}</nav></header><main id="main" tabindex="-1"><slot/></main><footer class="site-footer"><a href="/">Yunbo Shim <span lang="ko">심윤보</span></a><span>Research. Build. Keep learning.</span><a href="https://github.com/ybuser">GitHub <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></footer></body></html>
