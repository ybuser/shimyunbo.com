---
import Layout from '../layouts/Layout.astro';import {entries,categories} from '../data/entries';import {selectEntries,period,groupLabel} from '../lib/timeline';
const sorted=selectEntries(entries,[]);const years=[...new Set(sorted.map(groupLabel))];
---
<Layout title="Timeline — Yunbo Shim" dark description="Explore Yunbo Shim’s work, research, education, and activities through an interactive timeline."><div class="page-heading timeline-hero"><div class="timeline-top"><div><div class="eyebrow">A continuing record</div><h1>Timeline<span>.</span></h1></div><div class="index-number" aria-hidden="true">↘</div></div><p>Research, work, and everything in between.<br/>Follow a thread, or explore the whole story.</p></div><div class="filter-panel" id="filter-panel" hidden><div class="filters" role="group" aria-label="Filter timeline by category"><button class="filter" data-category="all" aria-pressed="true"><span class="check" aria-hidden="true">✓ </span>All</button>{Object.entries(categories).map(([id,name])=><button class="filter" data-category={id} aria-pressed="false"><span class="check" aria-hidden="true">✓ </span>{name}</button>)}</div><div class="filter-info"><span id="results" role="status" aria-live="polite" aria-atomic="true">{sorted.length} entries · All categories</span><button class="reset" id="reset">Reset filters</button></div></div><noscript><p class="no-js">All entries are shown. Enable JavaScript to filter by category. You can still expand each entry.</p></noscript><p class="timeline-note">Newest first. Spacing is not proportional to time. Dates retain their recorded precision.</p><div class="timeline-layout"><aside class="timeline-aside" aria-label="Jump to year"><div class="small-label aside-label">On this timeline</div>{years.map(y=><a data-year-link={y} href={'#year-'+y}>{y}</a>)}</aside><div><div class="axis">{years.map(y=><section class="year-group" data-year={y}><h2 class="year-heading" id={'year-'+y}>{y}</h2>{sorted.filter(e=>groupLabel(e)===y).map(e=><details class="entry" id={e.id} data-categories={e.categories.join(',')}><summary><span class="date">{period(e)}</span><h3>{e.title}</h3><p class="organization">{e.organization}</p><p class="summary">{e.summary}</p><span class="badges">{e.categories.map(c=><span class="badge">{categories[c]}</span>)}</span></summary><div class="entry-body"><div>{e.authors&&<p>{e.authors}</p>}{e.details.map(t=><p>{t}</p>)}{e.categories.includes('publications')&&<p><a href={'/research/'+e.id+'/'}>Research details <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></p>}<p><a href={'#'+e.id} aria-label={'Link to '+e.title}>Link to this entry <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></p></div></div></details>)}</section>)}</div><div class="empty" id="empty" hidden><h2>No entries in this selection.</h2><p>Try another category, or return to the full timeline.</p><button class="reset" id="empty-reset">Show all entries</button></div></div></div><script>
import {categories,type Category} from '../data/entries';
const allowed=new Set(Object.keys(categories));
const cards=[...document.querySelectorAll<HTMLDetailsElement>('.entry')];
const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-category]')];
const groups=[...document.querySelectorAll<HTMLElement>('[data-year]')];
let selected=new Set<Category>();
function fromURL(){const values=new URL(location.href).searchParams.get('categories')?.split(',')??[];selected=new Set(values.filter((v):v is Category=>allowed.has(v)));}
function render(){
 for(const card of cards){const visible=!selected.size||card.dataset.categories!.split(',').some(c=>selected.has(c as Category));if(!visible&&card.contains(document.activeElement)) buttons.find(b=>b.dataset.category==='all')?.focus();card.hidden=!visible;}
 for(const group of groups){group.hidden=![...group.querySelectorAll<HTMLElement>('.entry')].some(c=>!c.hidden);const a=document.querySelector<HTMLElement>(`[data-year-link="${group.dataset.year}"]`);if(a)a.hidden=group.hidden;}
 for(const b of buttons){b.setAttribute('aria-pressed',String(b.dataset.category==='all'?!selected.size:selected.has(b.dataset.category as Category)));}
 const count=cards.filter(c=>!c.hidden).length;
 document.querySelector('#results')!.textContent=`${count} ${count===1?'entry':'entries'} · ${selected.size?`${selected.size} ${selected.size===1?'category':'categories'} selected`:'All categories'}`;
 (document.querySelector('#empty') as HTMLElement).hidden=count>0;
}
function writeURL(){const u=new URL(location.href);if(selected.size)u.searchParams.set('categories',[...selected].sort().join(','));else u.searchParams.delete('categories');u.hash='';if(u.href!==location.href)history.pushState(null,'',u);}
function reset(){selected.clear();writeURL();render();}
for(const b of buttons)b.addEventListener('click',()=>{const c=b.dataset.category as Category|'all';if(c==='all')selected.clear();else if(selected.has(c))selected.delete(c);else selected.add(c);writeURL();render();});
document.querySelector('#reset')!.addEventListener('click',reset);
document.querySelector('#empty-reset')!.addEventListener('click',()=>{reset();buttons[0].focus();});
function anchor(){let id='';try{id=decodeURIComponent(location.hash.slice(1));}catch{return;}const card=cards.find(c=>c.id===id);if(!card)return;if(card.hidden){selected.clear();const u=new URL(location.href);u.searchParams.delete('categories');history.replaceState(null,'',u);render();}card.open=true;requestAnimationFrame(()=>card.scrollIntoView({block:'start',behavior:'instant'}));}
function restore(){fromURL();render();anchor();}
window.addEventListener('popstate',restore);window.addEventListener('hashchange',anchor);
// Restore expansions across A → B → A navigation without persisting personal data.
try{const ids:unknown=JSON.parse(sessionStorage.getItem('timeline-open')??'[]');if(Array.isArray(ids))for(const c of cards)c.open=ids.includes(c.id);}catch{/* Storage may be disabled. */}
for(const card of cards)card.addEventListener('toggle',()=>{try{sessionStorage.setItem('timeline-open',JSON.stringify(cards.filter(c=>c.open).map(c=>c.id)));}catch{/* Progressive enhancement remains usable. */}});
(document.querySelector('#filter-panel') as HTMLElement).hidden=false;restore();
</script></Layout>
