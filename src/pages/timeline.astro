---
import OriginalTitle from '../components/OriginalTitle.astro';
import {language,translate,localizedPath,categoryLabels} from '../i18n/ui';
import {localizedEntries} from '../i18n/entries';
const lang=language(Astro.url.pathname),t=(s:string)=>translate(s,lang),url=(s:string)=>localizedPath(s,lang);
import CategoryMark from '../components/CategoryMark.astro';
import Layout from '../layouts/Layout.astro';
import {selectEntries,period} from '../lib/timeline';
import {railColor,railLabel} from '../lib/rail-colors';
const entries=localizedEntries(lang),categories=categoryLabels(lang);
const compact=(e:typeof entries[number])=>!!e.milestone||e.categories.includes('certificates')||e.categories.includes('publications')||(!e.start&&e.categories.includes('honors')&&['deans-list','recommendation','excellence-2022','excellence-2023','leader-spring','leader-fall'].includes(e.id));
const sorted=selectEntries(entries,[]);
const icons={work:'—',research:'↗',activities:'↗',publications:'↗',honors:'○',certificates:'✓',education:'—',life:'◇'};
const visualKind=(e:typeof entries[number])=>e.project?'project':e.milestone??(e.id==='ict-volunteer'?'volunteering':e.id==='triple-s'?'sports':e.start?e.categories[0]:e.categories.includes('activities')?'activities':eventStyle(e));
const kindLabels:Record<string,string>={project:'Startup project',work:'Work experience',research:'Research experience',education:'Education',volunteering:'Volunteering',sports:'Sports & community',activities:'Activities',publication:'Publication',certificate:'Certificate',award:'Award',note:'Activity',birth:'Birth',move:'Relocation',enlistment:'Enlistment'};
const eventStyle=(e:typeof entries[number])=>e.milestone?'life':e.categories.includes('publications')?'publication':e.categories.includes('honors')?'award':e.categories.includes('certificates')?'certificate':'note';
---
<Layout title={t("Timeline")+" — "+t("Yunbo Shim")} dark>
<section class="page-heading timeline-hero"><h1>{t("Timeline")}<span>.</span></h1><button id="explore-rails" hidden type="button" aria-label={t("Magnify timeline")} title={t("Magnify timeline")} aria-haspopup="dialog" aria-controls="rail-lens" aria-expanded="false"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="m15 15 6 6M7 10h6M10 7v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button></section>
<p id="results" role="status" aria-live="polite">{lang==='ko'?`${sorted.length}개 이력 · 전체 카테고리`:`${sorted.length} entries · All categories`}</p>
<div id="chronology"><div id="rail-hit-area" aria-hidden="true" hidden></div><svg id="time-lines" aria-hidden="true"></svg>{sorted.map(e=><details class:list={["entry", {compact:compact(e)}]} id={e.id} data-categories={e.categories.join(',')} data-kind={e.start?'duration':'event'} data-primary={e.categories[0]} data-event-style={eventStyle(e)} data-visual={visualKind(e)} style={e.start?`--entry-tone:${railColor(e.id)}`:undefined}><summary>{e.start&&<span class="track-heading"><CategoryMark kind={visualKind(e)}/><span class="track-number">{railLabel(e.id)}</span><span>{e.organization}</span></span>}{!e.start&&<span class="event-emblem" aria-hidden="true"><CategoryMark kind={visualKind(e)}/></span>}<span class="entry-format">{t(kindLabels[visualKind(e)])}</span><span class="date">{period(e,lang)}</span>{e.categories.includes('publications')?<h3>{e.organization}</h3>:e.title&&e.title.toLowerCase()!=='school education'&&<h3>{e.title}</h3>}{!e.categories.includes('publications')&&eventStyle(e)!=='award'&&<p class="organization">{e.organization}</p>}{!e.start&&!e.categories.includes('publications')&&<p class="summary">{e.summary}</p>}{e.categories.includes('publications')&&e.status&&<span class="publication-status">{e.status}</span>}<span class="badges">{e.categories.map(c=><span class="badge"><span aria-hidden="true">{icons[c]} </span>{categories[c]}</span>)}{e.relatedIds?.includes('skku')&&<span class="badge">{t("SKKU education")}</span>}</span></summary><div class="entry-body"><div>{eventStyle(e)==='award'&&<p class="award-organizer"><strong>{t("Organizer")}: </strong>{e.organization}</p>}{e.id==='navy-enlistment'&&<p><a href="#navy">{t("Navy service")}</a></p>}{e.categories.includes('publications')&&<h4 class="paper-title">{e.title}</h4>}{(e.start||e.categories.includes('publications'))&&<p>{e.summary}</p>}<OriginalTitle id={e.id} lang={lang}/>{e.authors&&<p>{e.authors}</p>}{e.details.map(t=><p>{t}</p>)}{e.links&&<div class="project-links">{e.links.map(link=><a class="text-link" href={link.url}>{t(link.label)}</a>)}</div>}{e.relatedIds?.includes('skku')&&<p class="relation">{t("Part of")} <a href="#skku">{t("Sungkyunkwan University education")}</a></p>}{e.categories.includes('publications')&&<p><a href={url('/research/'+e.id+'/')}>{t("Research details")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></p>}</div></div></details>)}</div>
<div class="empty" id="empty" hidden><h2>{t("No matching entries.")}</h2><button class="reset" id="empty-reset">{t("Show all entries")}</button></div>
<div class="filter-dock" id="filter-dock" hidden><div id="filter-panel" class="floating-panel" hidden><div class="filter-info"><strong>{t("Explore by category")}</strong><button class="reset" id="reset">{t("Reset")}</button></div><div class="filters" role="group" aria-label={t("Timeline categories")}><button class="filter" data-category="all" aria-pressed="true">{t("All categories")}</button>{Object.entries(categories).map(([id,label])=><button class="filter" data-category={id} aria-pressed="false"><span aria-hidden="true">{icons[id as keyof typeof icons]} </span>{label}</button>)}</div></div><button id="filter-toggle" aria-expanded="false" aria-controls="filter-panel">{t("Filter")} <span id="filter-count">{t("All")}</span><span aria-hidden="true">⌃</span></button></div>
<noscript><p>{t("All entries are shown. Expand any entry to read more.")}</p></noscript>
<script src="../scripts/timeline.ts"></script>
</Layout>

<style is:global>
/* Shared disclosure typography: entry category, compact layout and language
   may change decoration and spacing, but never the reading or link scale. */
#chronology .entry-body {
  --detail-body-size: 14px;
  --detail-heading-size: 16px;
  font-family: Arial, 'Noto Sans KR', sans-serif;
  font-size: var(--detail-body-size);
  line-height: 1.7;
}
#chronology .entry-body :is(p, a, .original-title, .original-title strong) {
  font-family: inherit;
  font-size: var(--detail-body-size);
  line-height: inherit;
}
#chronology .entry-body :is(h4, .paper-title) {
  font-family: inherit;
  font-size: var(--detail-heading-size);
  font-weight: 600;
  line-height: 1.5;
  margin: 0 0 12px;
}
#chronology .entry-body a {
  font-weight: 400;
  overflow-wrap: anywhere;
}
</style>
