---
import CategoryMark from '../components/CategoryMark.astro';
import Layout from '../layouts/Layout.astro';
import {entries,categories} from '../data/entries';
import {selectEntries,period} from '../lib/timeline';
import {railColor,railLabel} from '../lib/rail-colors';
const sorted=selectEntries(entries,[]);
const icons={work:'—',research:'↗',activities:'↗',publications:'↗',honors:'○',certificates:'✓',education:'—'};
const visualKind=(e:typeof entries[number])=>e.id==='ict-volunteer'?'volunteering':e.id==='triple-s'?'sports':e.start?e.categories[0]:e.categories.includes('activities')?'activities':eventStyle(e);
const kindLabels:Record<string,string>={work:'Work experience',research:'Research experience',education:'Education',volunteering:'Volunteering',sports:'Sports & community',activities:'Activities',publication:'Publication',certificate:'Certificate',award:'Award',note:'Activity'};
const eventStyle=(e:typeof entries[number])=>e.categories.includes('publications')?'publication':e.categories.includes('honors')?'award':e.categories.includes('certificates')?'certificate':'note';
---
<Layout title="Timeline — Yunbo Shim" dark>
<section class="page-heading timeline-hero"><div class="eyebrow">A continuing record</div><h1>Timeline<span>.</span></h1><p>Research, work, and everything in between.</p></section>
<p class="timeline-note">Read from present to past. Rails show periods; circles mark individual moments. The shared time axis expands around cards: spacing is not proportional to elapsed time. Partial dates stay approximate; overlaps do not imply affiliation.</p>
<div class="track-guide"><span class="guide-lines" aria-hidden="true"><i></i><i></i><i></i></span><p><strong>Follow a thread.</strong> Each numbered ribbon is one experience. Hover or focus an experience to trace its full period.</p></div><p id="results" role="status" aria-live="polite">{sorted.length} entries · All categories</p>
<div id="chronology"><svg id="time-lines" aria-hidden="true"></svg>{sorted.map(e=><details class="entry" id={e.id} data-categories={e.categories.join(',')} data-kind={e.start?'duration':'event'} data-primary={e.categories[0]} data-event-style={eventStyle(e)} data-visual={visualKind(e)} style={e.start?`--entry-tone:${railColor(e.id)}`:undefined}><summary>{e.start&&<span class="track-heading"><CategoryMark kind={visualKind(e)}/><span class="track-number">{railLabel(e.id)}</span><span>{e.organization}</span></span>}{!e.start&&<span class="event-emblem" aria-hidden="true"><CategoryMark kind={visualKind(e)}/></span>}<span class="entry-format">{kindLabels[visualKind(e)]}</span><span class="date">{period(e)}</span><h3>{e.title}</h3><p class="organization">{e.organization}</p><p class="summary">{e.summary}</p><span class="badges">{e.categories.map(c=><span class="badge"><span aria-hidden="true">{icons[c]} </span>{categories[c]}</span>)}{e.relatedIds?.includes('skku')&&<span class="badge">SKKU education</span>}</span></summary><div class="entry-body"><div>{e.authors&&<p>{e.authors}</p>}{e.details.map(t=><p>{t}</p>)}{e.relatedIds?.includes('skku')&&<p class="relation">Part of <a href="#skku">Sungkyunkwan University education</a></p>}{e.categories.includes('publications')&&<p><a href={'/research/'+e.id+'/'}>Research details <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></p>}<p><a href={'#'+e.id}>Link to this entry <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></p></div></div></details>)}</div>
<div class="empty" id="empty" hidden><h2>No matching entries.</h2><button class="reset" id="empty-reset">Show all entries</button></div>
<div class="filter-dock" id="filter-dock" hidden><div id="filter-panel" class="floating-panel" hidden><div class="filter-info"><strong>Explore by category</strong><button class="reset" id="reset">Reset</button></div><div class="filters" role="group" aria-label="Timeline categories"><button class="filter" data-category="all" aria-pressed="true">All categories</button>{Object.entries(categories).map(([id,label])=><button class="filter" data-category={id} aria-pressed="false"><span aria-hidden="true">{icons[id as keyof typeof icons]} </span>{label}</button>)}</div></div><button id="filter-toggle" aria-expanded="false" aria-controls="filter-panel">Filter <span id="filter-count">All</span><span aria-hidden="true">⌃</span></button></div>
<noscript><p>All entries are shown. Expand any entry to read more.</p></noscript>
<script src="../scripts/timeline.ts"></script>
</Layout>
