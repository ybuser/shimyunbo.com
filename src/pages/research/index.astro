---
import Layout from '../../layouts/Layout.astro';import {entries} from '../../data/entries';import {selectEntries,dateText} from '../../lib/timeline';
const papers=selectEntries(entries,['publications']);
---
<Layout title="Research — Yunbo Shim"><div class="page-heading"><div class="eyebrow">Ideas & investigations</div><h1>Research<span style="color:var(--accent)">.</span></h1><p>Selected manuscripts and publications, from language models to immersive visualization and software systems.</p></div>{papers.map(e=><article class="paper"><div class="meta">{dateText(e.date)}</div><div><span class="status">{e.status}</span><h2><a href={'/research/'+e.id+'/'}>{e.title}</a></h2><p>{e.authors}</p><p>{e.organization}</p><a class="text-link" href={'/research/'+e.id+'/'}>Details <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></div></article>)}<section><div class="section-heading"><h2>Selected projects</h2><span class="small-label">Built in practice</span></div><div class="research-grid"><article class="feature"><span class="number">VISUALIZATION</span><h3>Academic MOIRAI</h3><p>An interactive exploration of philosophers and their intellectual relationships through linked timeline, map, and network views.</p><div class="project-links"><a class="text-link" href="https://github.com/ybuser/Academic-MOIRAI">GitHub repository</a><a class="text-link" href="https://ybuser.github.io/Academic-MOIRAI/">Project website</a></div></article><article class="feature"><span class="number">WEB PLATFORM</span><h3>fanCake</h3><p>A fan–creator video NFT sharing platform. Public code includes a React frontend and a Java/Spring backend scaffold.</p><div class="project-links"><a class="text-link" href="https://github.com/ybuser/fancake_frontend">Frontend repository</a><a class="text-link" href="https://github.com/ybuser/fanCake">Backend repository</a></div></article><article class="feature"><span class="number">BANNANGCO</span><h3>MusePicker</h3><p>An attraction-ticket metasearch platform. Built data-collection pipelines and LLM-assisted categorization.</p><a class="text-link" href="/timeline/#bannangco">View experience</a></article><article class="feature"><span class="number">SKKU METAVERSE STUDIO</span><h3>Spore Survival</h3><p>Led a VR survival game project using Unity 3D, C#, VFX, and XR Interaction Toolkit. Entered GIGDC.</p><a class="text-link" href="/timeline/#metaverse">View experience</a></article></div></section><div class="journey-cta"><div><h2>Behind the papers</h2><p>Explore research experience and the broader story.</p></div><a class="timeline-link" href="/timeline/?categories=research">Research timeline <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></div></Layout>
