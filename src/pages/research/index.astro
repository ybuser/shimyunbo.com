---
import {language,translate,localizedPath} from '../../i18n/ui';
import {localizedEntries} from '../../i18n/entries';
const lang=language(Astro.url.pathname),t=(s:string)=>translate(s,lang),url=(s:string)=>localizedPath(s,lang);
import Layout from '../../layouts/Layout.astro';import {selectEntries,dateText} from '../../lib/timeline';
const entries=localizedEntries(lang);
const papers=selectEntries(entries,['publications']);
---
<Layout title={t("Research")+" — "+t("Yunbo Shim")}><div class="page-heading"><div class="eyebrow">{t("Ideas & investigations")}</div><h1>{t("Research")}<span style="color:var(--accent)">.</span></h1><p>{t("Selected manuscripts and publications, from language models to immersive visualization and software systems.")}</p></div>{papers.map(e=><article class="paper"><div class="meta">{dateText(e.date,lang)}</div><div><span class="status">{e.status}</span><h2><a href={url('/research/'+e.id+'/')}>{e.title}</a></h2><p>{e.authors}</p><p>{e.organization}</p><a class="text-link" href={url('/research/'+e.id+'/')}>{t("Details")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></div></article>)}<section><div class="section-heading"><h2>{t("Selected projects")}</h2><span class="small-label">{t("Built in practice")}</span></div><div class="research-grid"><article class="feature"><span class="number">{t("VISUALIZATION")}</span><h3>Academic MOIRAI</h3><p>{t("An interactive exploration of philosophers and their intellectual relationships through linked timeline, map, and network views.")}</p><div class="project-links"><a class="text-link" href="https://github.com/ybuser/Academic-MOIRAI">{t("GitHub repository")}</a><a class="text-link" href="https://ybuser.github.io/Academic-MOIRAI/">{t("Project website")}</a></div></article><article class="feature"><span class="number">{t("WEB PLATFORM")}</span><h3>fanCake</h3><p>{t("A fan–creator video NFT sharing platform. Public code includes a React frontend and a Java/Spring backend scaffold.")}</p><div class="project-links"><a class="text-link" href="https://github.com/ybuser/fancake_frontend">{t("Frontend repository")}</a><a class="text-link" href="https://github.com/ybuser/fanCake">{t("Backend repository")}</a></div></article><article class="feature"><span class="number">{t("BANNANGCO")}</span><h3>MusePicker</h3><p>{t("An attraction-ticket metasearch platform. Built data-collection pipelines and LLM-assisted categorization.")}</p><a class="text-link" href={url("/timeline/#bannangco")}>{t("View experience")}</a></article><article class="feature"><span class="number">{t("SKKU METAVERSE STUDIO")}</span><h3>Spore Survival</h3><p>{t("Led a VR survival game project using Unity 3D, C#, VFX, and XR Interaction Toolkit. Entered GIGDC.")}</p><a class="text-link" href={url("/timeline/#metaverse")}>{t("View experience")}</a></article></div></section><div class="journey-cta"><div><h2>{t("Behind the papers")}</h2><p>{t("Explore research experience and the broader story.")}</p></div><a class="timeline-link" href={url("/timeline/?categories=research")}>{t("Research timeline")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></div></Layout>
