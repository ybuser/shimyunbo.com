---
import {language,translate,localizedPath} from '../../i18n/ui';
import {localizedEntries} from '../../i18n/entries';
const lang=language(Astro.url.pathname),t=(s:string)=>translate(s,lang),url=(s:string)=>localizedPath(s,lang);
import Layout from '../../layouts/Layout.astro';import {selectEntries,dateText} from '../../lib/timeline';
const entries=localizedEntries(lang);
const papers=selectEntries(entries,['publications']);
---
<Layout title={t("Research")+" — "+t("Yunbo Shim")}><div class="page-heading"><h1>{t("Research")}<span style="color:var(--accent)">.</span></h1></div>{papers.map(e=><article class="paper"><div class="meta">{dateText(e.date,lang)}</div><div><span class="status">{e.status}</span><h2><a href={url('/research/'+e.id+'/')}>{e.title}</a></h2><p>{e.authors}</p><p>{e.organization}</p><a class="text-link" href={url('/research/'+e.id+'/')}>{t("Details")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></div></article>)}<section><div class="section-heading"><h2>{t("Selected projects")}</h2><span class="small-label">{t("Built in practice")}</span></div><div class="research-grid"><article class="feature"><span class="number">{t("MARKET ANALYSIS")}</span><h3>IBK Analytical Trading</h3><p>{t("A team research platform for finding similar historical market periods. Its Sector Clustering pipeline combines RobustScaler, TruncatedSVD, and Affinity Propagation, with React, Django, and MongoDB supporting market analysis, EDA, and portfolio views.")}</p><div class="project-links"><a class="text-link" href="https://github.com/ibk-project/ibk-analytical-trading">{t("GitHub repository")}</a><a class="text-link" href="https://github.com/user-attachments/assets/7fbb5a14-92cd-4e45-9ca5-867d88a722bb">{t("Project poster")}</a><a class="text-link" href="https://mrdang.cs.skku.edu/video?id=415">{t("Presentation")}</a><a class="text-link" href={url("/timeline/#ibk")}>{t("View experience")}</a></div></article><article class="feature"><span class="number">{t("VISUALIZATION")}</span><h3>Academic MOIRAI</h3><p>{t("A team project built with SNU lab members for an information visualization course I audited. React and D3 coordinate a searchable philosopher timeline, map, and relationship detail view to explore intellectual influence.")}</p><div class="project-links"><a class="text-link" href="https://github.com/ybuser/Academic-MOIRAI">{t("GitHub repository")}</a><a class="text-link" href="https://ybuser.github.io/Academic-MOIRAI/">{t("Project website")}</a><a class="text-link" href="https://github.com/ybuser/Academic-MOIRAI/assets/16937724/ff8fe9ad-c5e4-4516-83dc-98e61a626f0e">{t("Project poster")}</a><a class="text-link" href={url("/timeline/#snu-hci")}>{t("View experience")}</a></div></article><article class="feature"><span class="number">{t("WEB PLATFORM")}</span><h3>fanCake</h3><p>{t("An NFT-based platform for trading creator video clips. The team interviewed creators and fans, registered creator videos in an MVP, and refined UX using analytics and usability testing.")}</p><div class="project-links"><a class="text-link" href="https://github.com/ybuser/fancake_frontend">{t("Frontend repository")}</a><a class="text-link" href="https://github.com/ybuser/fanCake">{t("Backend repository")}</a><a class="text-link" href="https://m.blog.naver.com/dreamkonkuk/222633750705">{t("Konkuk University team interview")}</a><a class="text-link" href={url("/timeline/#fancake")}>{t("View experience")}</a></div></article><article class="feature"><span class="number">{t("BANNANGCO")}</span><h3>MusePicker</h3><p>{t("An attraction-ticket metasearch platform. Built data-collection pipelines and LLM-assisted categorization.")}</p><a class="text-link" href={url("/timeline/#bannangco")}>{t("View experience")}</a></article><article class="feature"><span class="number">{t("SKKU METAVERSE STUDIO")}</span><h3>Spore Survival</h3><p>{t("Led a VR survival game project using Unity 3D, C#, VFX, and XR Interaction Toolkit. Entered GIGDC.")}</p><a class="text-link" href={url("/timeline/#metaverse")}>{t("View experience")}</a></article></div></section><div class="journey-cta"><div><h2>{t("Behind the papers")}</h2><p>{t("Explore research experience and the broader story.")}</p></div><a class="timeline-link" href={url("/timeline/?categories=research")}>{t("Research timeline")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></div></Layout>
