---
import OriginalTitle from '../../components/OriginalTitle.astro';
import {language,translate,localizedPath} from '../../i18n/ui';
import {localizedEntries} from '../../i18n/entries';
const lang=language(Astro.url.pathname),t=(s:string)=>translate(s,lang),url=(s:string)=>localizedPath(s,lang);
import Layout from '../../layouts/Layout.astro';import {entries as originalEntries} from '../../data/entries';import {dateText} from '../../lib/timeline';
export function getStaticPaths(){return originalEntries.filter(e=>e.categories.includes('publications')).map(e=>({params:{slug:e.id},props:{entry:e}}));}
const e=localizedEntries(lang).find(e=>e.id===Astro.props.entry.id)!;
---
<Layout title={e.title+' — '+t('Yunbo Shim')} description={e.summary}><div class="page-heading"><a href={url("/research/")} class="text-link">{t("← All research")}</a><p class="eyebrow">{e.status ? `${e.status} · ` : ''}{dateText(e.date,lang)}</p><h1 style="font-size:clamp(32px,4vw,49px);letter-spacing:-1px">{e.title}</h1><p>{e.authors}</p></div><section class="prose"><OriginalTitle id={e.id} lang={lang}/><h2>{e.organization}</h2>{e.details.map(t=><p>{t}</p>)}<div class="actions"><a class="timeline-link" href={url('/timeline/#'+e.id)}>{t("View in timeline")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a><a class="text-link" href="mailto:yunboshim@gmail.com">{t("Contact about this work")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></div></section></Layout>
