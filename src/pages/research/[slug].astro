---
import Layout from '../../layouts/Layout.astro';import {entries} from '../../data/entries';import {dateText} from '../../lib/timeline';
export function getStaticPaths(){return entries.filter(e=>e.categories.includes('publications')).map(e=>({params:{slug:e.id},props:{entry:e}}));}
const {entry:e}=Astro.props;
---
<Layout title={e.title+' — Yunbo Shim'} description={e.summary}><div class="page-heading"><a href="/research/" class="text-link">← All research</a><p class="eyebrow">{e.status ? `${e.status} · ` : ''}{dateText(e.date)}</p><h1 style="font-size:clamp(32px,4vw,49px);letter-spacing:-1px">{e.title}</h1><p>{e.authors}</p></div><section class="prose"><h2>{e.organization}</h2>{e.details.map(t=><p>{t}</p>)}<div class="actions"><a class="timeline-link" href={'/timeline/#'+e.id}>View in timeline <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a><a class="text-link" href="mailto:yunboshim@gmail.com">Contact about this work <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></div></section></Layout>
