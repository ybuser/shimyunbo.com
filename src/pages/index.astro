---
import {language,translate,localizedPath} from '../i18n/ui';
const lang=language(Astro.url.pathname),t=(s:string)=>translate(s,lang),url=(s:string)=>localizedPath(s,lang);
import Layout from '../layouts/Layout.astro';
---
<Layout><section class="profile-hero"><div><div class="eyebrow">{t("Hello, I'm")}</div><h1>{t("Yunbo Shim")}<span style="color:var(--accent)">.</span></h1><div class="profile-now">{t("AI Specialist Soldier · Republic of Korea Navy")}<br/>{t("B.S. Computer Science & Engineering · Sungkyunkwan University")}</div><div class="profile-links"><a href="mailto:yunboshim@gmail.com">{t("Email")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a><a href="https://github.com/ybuser">GitHub <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a><a href="https://www.linkedin.com/in/yunbo-shim">LinkedIn <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a><a href={url("/cv/")}>{t("CV")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></div></div><aside class="work-notebook" aria-label={t("Selected work")}><div class="notebook-label">{t("A few selected threads")} <span aria-hidden="true"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4"/></svg></span></div><a class="work-thread thread-research" href={url("/research/parent-resolution/")}><span class="thread-index">{t("01 / RESEARCH")}</span><h2>{t("How do models")}<br/>{t("make sense of context?")}</h2><span class="thread-caption">Parent Resolution from Context<br/>{t("Manuscript · 2026")}</span><span class="thread-arrow" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4"/></svg></span></a><a class="work-thread thread-building" href={url("/timeline/#bannangco")}><span class="thread-index">{t("02 / BUILDING")}</span><h2>{t("From an idea")}<br/>{t("to something people use.")}</h2><span class="thread-caption">{t("Bannangco · Founder")}<br/>{t("MeetingGO, Friending & Splash")}</span><span class="thread-arrow" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4"/></svg></span></a><a class="work-footnote" href={url("/research/kiit-2023/")}><span>{t("03 / VISUALIZATION")}</span><strong>{t("Seeing high-dimensional data differently.")}</strong><span aria-hidden="true"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4"/></svg></span></a></aside></section><section class="personal-section"><h2>{t("What I've been working on")}</h2><div class="focus-cards"><article class="focus-card"><div class="small-label">{t("Research")}</div><h3>{t("Understanding models & information")}</h3><p>{t("A manuscript on feature composition and LLM behavior, alongside earlier work in immersive visualization.")}</p><a class="text-link" href={url("/research/")}>{t("Read my research")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></article><article class="focus-card"><div class="small-label">{t("Building")}</div><h3>{t("From an idea to a working product")}</h3><p>{t("Experience founding small teams and developing consumer services, web platforms, and AI workflows.")}</p><a class="text-link" href={url("/timeline/#bannangco")}>{t("Explore the experience")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></article><article class="focus-card"><div class="small-label">{t("Beyond the work")}</div><h3>{t("Learning with other people")}</h3><p>{t("ICT education in Thailand, programming mentorship, and a student sports community.")}</p><a class="text-link" href={url("/timeline/?categories=activities")}>{t("Explore activities")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></article></div></section><section class="journey-cta"><div><div class="eyebrow">{t("The longer view")}</div><h2 style="font-family:Arial,sans-serif">{t("Follow the journey.")}</h2><p>{t("A connected view of research, work, and learning.")}</p></div><a class="timeline-link" href={url("/timeline/")}>{t("Explore the timeline")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></section></Layout>
