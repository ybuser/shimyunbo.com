---
import Layout from '../layouts/Layout.astro';
import {entries} from '../data/entries';
const featured=entries.filter(e=>['snu-hci','ibk'].includes(e.id));
---
<Layout><section class="hero"><div><div class="eyebrow">Research · Software · Exploration</div><h1>Yunbo Shim<span style="color:var(--accent)">.</span></h1><p class="intro">I work across AI development, visualization, and software. My experience spans research internships, product development, and student-led projects.</p><div class="actions"><a class="text-link" href="/research/">Explore my research <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a><a class="text-link" href="mailto:yunboshim@gmail.com">Get in touch <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></div></div><aside class="hero-side"><p><span class="small-label">Currently</span><br/>AI Specialist Soldier<br/>Republic of Korea Navy</p><p><span class="small-label">Education</span><br/>B.S. Computer Science & Engineering<br/>Sungkyunkwan University</p><p><span class="small-label">Elsewhere</span><br/><a href="https://github.com/ybuser">GitHub <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></p></aside></section><section><div class="section-heading"><h2>A few threads of my work</h2><span class="small-label">01 / Research</span></div><div class="research-grid">{featured.map((e,i)=><article class="feature"><span class="number">0{i+1} — {e.organization.split(' · ')[0]}</span><h3><a href={'/timeline/#'+e.id}>{e.summary}</a></h3><p>{e.details.at(-1)}</p><a class="text-link" href={'/timeline/#'+e.id}>Read the experience <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></article>)}</div></section><section class="journey-cta"><div><div class="eyebrow">The longer view</div><h2>A continuing record.</h2><p>Research, work, education, and the things learned along the way.</p></div><a class="timeline-link" href="/timeline/">Explore the timeline <span aria-hidden="true"><svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></span></a></section></Layout>
