---
import {language,translate,localizedPath} from '../i18n/ui';
import {homeCopy,sportIds} from '../i18n/home';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import HobbySketch from '../components/HobbySketch.astro';
import '../styles/home.css';
import ArticleList from '../components/ArticleList.astro';
import {articleCopy} from '../i18n/articles';
const lang=language(Astro.url.pathname),t=(s:string)=>translate(s,lang),url=(s:string)=>localizedPath(s,lang);
const copy=homeCopy[lang];
---
<Layout>
  <section class="home-hero" aria-labelledby="hello-title">
    <div class="home-intro">
      <div class="eyebrow">{t("Hello, I'm")}</div>
      <h1 id="hello-title">{t('Yunbo Shim')}<span>.</span></h1>
      <div class="home-current">{t('AI Development Specialist Soldier · Republic of Korea Navy')}<br/>{t('B.S. Computer Science & Engineering · Sungkyunkwan University')}</div>
      <div class="home-links">
        <a href="mailto:yunboshim@gmail.com">{t('Email')} <Arrow/></a>
        <a href="https://github.com/ybuser">GitHub <Arrow/></a>
        <a href="https://www.linkedin.com/in/yunbo-shim">LinkedIn <Arrow/></a>
        <a href={url('/cv/')}>{t('CV')} <Arrow/></a>
      </div>
    </div>
  <section class="curiosity" aria-labelledby="curiosity-title">
    <div class="curiosity-heading">
      <div><div class="eyebrow">{copy.eyebrow}</div><h2 id="curiosity-title">{copy.heading}</h2></div>
      <p>{copy.intro}</p>
    </div>
    <div class="playgrounds">
      <article class="tech-playground" aria-labelledby="tech-title">
        <div class="playground-label">{copy.techLabel}<span aria-hidden="true">✳</span></div>
        <div class="sketch-frame"><HobbySketch kind="tech"/></div>
        <div class="playground-copy"><h3 id="tech-title">{copy.techTitle}</h3><p>{copy.techText}</p><div class="handwritten-note">{copy.techNote}</div></div>
      </article>
      <div class="sport-playground" data-sport-notebook>
        <div class="playground-label">{copy.sportLabel}<span aria-hidden="true">✳</span></div>
        <div class="sport-picker" role="tablist" aria-label={copy.sportTabs} hidden>
          {sportIds.map((id,index)=><button type="button" id={`tab-${id}`} role="tab" aria-controls={`sport-${id}`} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1} data-sport={id}>{copy[id].label}</button>)}
        </div>
        <div class="sport-pages">
          {sportIds.map(id=><article class="sport-page" id={`sport-${id}`} data-sport-page={id} aria-labelledby={`title-${id}`}>
            <div class="sketch-frame"><HobbySketch kind={id}/></div>
            <div class="playground-copy">
              <div class="sport-fallback-label">{copy[id].label}</div>
              <h3 id={`title-${id}`}>{copy[id].title}</h3><p>{copy[id].text}</p>
              {id==='sailing'?<div class="sailing-record"><div>{copy.sailing.note}</div><strong>{copy.sailing.result}</strong><span>{copy.sailing.years}<span class="record-separator" aria-hidden="true"> / </span>{copy.sailing.classes}</span></div>:<div class="handwritten-note">{copy[id].note}</div>}
            </div>
          </article>)}
        </div>
        <p class="sport-hint" hidden>{copy.sportHint}</p>
      </div>
    </div>
  </section>
  </section>
  <section class="latest-updates" id="latest" aria-labelledby="latest-title">
    <header class="journal-heading">
      <div><div class="eyebrow">{articleCopy[lang].eyebrow}</div><h2 id="latest-title">{articleCopy[lang].heading}<span aria-hidden="true">.</span></h2></div>
      <p>{articleCopy[lang].intro}</p>
    </header>
    <div class="journal-index"><span>{articleCopy[lang].indexLabel}</span><span>{articleCopy[lang].orderLabel}</span></div>
    <ArticleList lang={lang}/>
    <p class="journal-footnote">{articleCopy[lang].placeholderNote}</p>
  </section>
</Layout>
<script>
  // Every story remains readable without JS; tabs progressively enhance the notebook.
  const notebook=document.querySelector<HTMLElement>('[data-sport-notebook]');
  if(notebook){
    const picker=notebook.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs=Array.from(picker.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const pages=Array.from(notebook.querySelectorAll<HTMLElement>('[data-sport-page]'));
    const select=(index:number,focus=false)=>{
      tabs.forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1;});
      pages.forEach((page,i)=>{page.hidden=i!==index;});
      if(focus)tabs[index].focus();
    };
    pages.forEach((page,i)=>{page.setAttribute('role','tabpanel');page.setAttribute('aria-labelledby',tabs[i].id);page.tabIndex=0;});
    tabs.forEach((tab,index)=>{
      tab.addEventListener('click',()=>select(index));
      tab.addEventListener('keydown',(event)=>{
        if(event.altKey||event.ctrlKey||event.metaKey)return;
        let next=index;
        if(event.key==='ArrowRight')next=(index+1)%tabs.length;
        else if(event.key==='ArrowLeft')next=(index+tabs.length-1)%tabs.length;
        else if(event.key==='Home')next=0;
        else if(event.key==='End')next=tabs.length-1;
        else return;
        event.preventDefault();select(next,true);
      });
    });
    select(0);picker.hidden=false;
    notebook.querySelector<HTMLElement>('.sport-hint')!.hidden=false;
    notebook.classList.add('is-interactive');
  }
</script>
