---
import Layout from '../layouts/Layout.astro';import {entries,categories,type Category} from '../data/entries';import {selectEntries,period} from '../lib/timeline';
const sections:Category[]=['education','research','work','publications','certificates'];
---
<Layout title="CV — Yunbo Shim"><div class="page-heading cv-heading"><div><div class="eyebrow">Curriculum vitae</div><h1>Yunbo Shim.</h1><p>A selected record of education, research, and work.</p><p class="print-only">yunboshim@gmail.com · github.com/ybuser · shimyunbo.com</p></div><a class="button no-print" href="/files/cv.pdf" download="Yunbo-Shim-CV.pdf">Download CV <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2v10m-4-4 4 4 4-4M2 14h12" stroke="currentColor" stroke-width="1.4"/></svg></a></div>{sections.map(c=><section><div class="section-heading"><h2>{categories[c]}</h2></div>{selectEntries(entries,[c]).filter(e=>c==='certificates'||e.selected).map(e=><article class="cv-row"><div class="date">{period(e)}</div><div><h3>{e.title}</h3><p>{e.organization}</p>{e.authors&&<p>{e.authors}</p>}<p>{e.summary}</p></div></article>)}</section>)}<div class="journey-cta no-print"><div><h2>More than a résumé.</h2><p>Browse activities, awards, and the full chronology.</p></div><a class="timeline-link" href="/timeline/">Explore the timeline <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></div></Layout>
