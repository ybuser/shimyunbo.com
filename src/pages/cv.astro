---
import {language,translate,localizedPath,categoryLabels} from '../i18n/ui';
import {localizedEntries} from '../i18n/entries';
const lang=language(Astro.url.pathname),t=(s:string)=>translate(s,lang),url=(s:string)=>localizedPath(s,lang);
import Layout from '../layouts/Layout.astro';import {type Category} from '../data/entries';import {selectEntries,period} from '../lib/timeline';
const entries=localizedEntries(lang),categories=categoryLabels(lang);
const sections:Category[]=['education','research','work','publications','certificates'];
---
<Layout title={t("CV")+" — "+t("Yunbo Shim")}><div class="page-heading cv-heading"><div><div class="eyebrow">{t("Curriculum vitae")}</div><h1>{t("Yunbo Shim")}.</h1><p>{t("A selected record of education, research, and work.")}</p><p class="print-only">yunboshim@gmail.com · github.com/ybuser · shimyunbo.com</p></div></div>{sections.map(c=><section><div class="section-heading"><h2>{categories[c]}</h2></div>{selectEntries(entries,[c]).filter(e=>c==='certificates'||e.selected).map(e=><article class="cv-row"><div class="date">{period(e,lang)}</div><div><h3>{e.title}</h3><p>{e.organization}</p>{e.authors&&<p>{e.authors}</p>}<p>{e.summary}</p></div></article>)}</section>)}<div class="journey-cta no-print"><div><h2>{t("More than a résumé.")}</h2><p>{t("Browse activities, awards, and the full chronology.")}</p></div><a class="timeline-link" href={url("/timeline/")}>{t("Explore the timeline")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></div></Layout>
