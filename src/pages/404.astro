---
import {language,translate,localizedPath} from '../i18n/ui';
const lang=language(Astro.url.pathname),t=(s:string)=>translate(s,lang),url=(s:string)=>localizedPath(s,lang);
import Layout from '../layouts/Layout.astro';
---
<Layout title={t("Page not found")+" — "+t("Yunbo Shim")}><div class="page-heading"><div class="eyebrow">404</div><h1>{t("A missing page.")}</h1><p>{t("This address does not lead to a page here.")}</p><a class="text-link" href={url("/")}>{t("Return home")} <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a></div></Layout>
<script>
// Static hosts serve one 404 document for unknown paths. Use the same authored
// Korean dictionary on /ko/* failures without redirecting or changing HTTP status.
import {language,translate,localizedPath} from '../i18n/ui';
if(language(location.pathname)==='ko'&&document.documentElement.lang!=='ko'){
 document.documentElement.lang='ko';document.title='페이지를 찾을 수 없습니다 — 심윤보';
 const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);let node:Node|null;
 while(node=walker.nextNode()){if(node.parentElement?.closest('script,style,[data-language]'))continue;const v=node.textContent??'',trim=v.trim();if(trim)node.textContent=v.replace(trim,translate(trim,'ko'));}
 document.querySelectorAll('[aria-label]').forEach(el=>el.setAttribute('aria-label',translate(el.getAttribute('aria-label')!,'ko')));
 document.querySelectorAll<HTMLAnchorElement>('a[href^="/"]').forEach(a=>{if(!a.dataset.language)a.href=localizedPath(a.getAttribute('href')!,'ko');});
 document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(a=>{a.href=a.dataset.language==='ko'?'/ko/404/':'/404.html';if(a.dataset.language==='ko')a.setAttribute('aria-current','page');else a.removeAttribute('aria-current');});
 document.querySelector('meta[name="description"]')?.setAttribute('content','요청하신 주소에 페이지가 없습니다.');
}
</script>
